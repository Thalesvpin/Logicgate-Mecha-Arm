[resource]
script = ExtResource("4_6n4lp")
id = 28
name = "Experiência de Quase Morte"
description = "caso o jogador tenha este Modifier em seu Inventário no momento em que levar um Dano que seria letal, ao invés de morrer, o jogador é Curado em até 60% de sua Vida Máxima, e este Modifier é destruído. Ao mesmo tempo, quem desferiu o ataque que teria sido letal também é Curado, em até 40% de sua Vida Máxima. Normalmente, isso seria um inimigo, mas o jogador pode manipular este modifier a seu favor: caso o jogador esteja com pouca Vida, ele pode executar uma Ação de Dano Próprio para ele mesmo “se matar” - mas, como foi ele mesmo quem desferiu o ataque, ele iria ganhar a cura de +40% de sua Vida Máxima, por cima da cura de +60% de sua Vida Máxima que ele normalmente já ganharia, efetivamente ganhando 100% de sua vida de volta."
type = 1
metadata/_custom_type_script = "uid://bljex6smxx3gr"
